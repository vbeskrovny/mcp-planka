{
  "name": "mcp-planka",
  "version": "0.1.0",
  "description": "MCP server for Planka v2 kanban boards",
  "type": "module",
  "bin": {
    "mcp-planka": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "watch": "node dist/watch.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/unit",
    "test:int": "MCP_APP_PLANKA_INTEGRATION=1 vitest run test/integration --testTimeout 30000"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
